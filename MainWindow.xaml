<Window x:Class="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ordering System" Width="1280" Height="780" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="Inter, Segoe UI">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="216"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ SIDEBAR ============ -->
        <Border Grid.Column="0" Background="{StaticResource PrimaryBrush}" Padding="16,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand (name + logo come from Settings) -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8,0,8,20">
                    <Border x:Name="LogoBox" Width="38" Height="38" CornerRadius="12"
                            Background="{StaticResource PrimaryLightBrush}">
                        <TextBlock x:Name="LogoGlyph" Text="&#x2615;" FontFamily="Segoe UI Symbol"
                                   FontSize="18" Foreground="{StaticResource TextBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtBrand" Text="Hearth" FontSize="19" FontWeight="Bold"
                                   Foreground="{StaticResource BgBrush}"/>
                        <TextBlock Text="CAFÉ WORKSPACE" FontSize="10"
                                   Foreground="{StaticResource BgBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Navigation -->
                <StackPanel Grid.Row="1">
                    <TextBlock Text="WORKSPACE" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource BgBrush}" Margin="0,0,0,8"/>

                    <RadioButton x:Name="NavOrder" Content="Order" GroupName="Nav"
                                 Tag="&#xE7BF;" Style="{StaticResource NavButton}"
                                 Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavOrders" Content="Order Management" GroupName="Nav"
                                 Tag="&#xE8A5;" Style="{StaticResource NavButton}"
                                 Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavMenu" Content="Menu Management" GroupName="Nav"
                                 Tag="&#xE700;" Style="{StaticResource NavButton}"
                                 Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavDashboard" Content="Dashboard" GroupName="Nav"
                                 Tag="&#xE9D9;" Style="{StaticResource NavButton}"
                                 Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavSettings" Content="Settings" GroupName="Nav"
                                 Tag="&#xE713;" Style="{StaticResource NavButton}"
                                 Checked="Nav_Checked"/>
                </StackPanel>

                <!-- Exit pinned to the bottom -->
                <Button Grid.Row="3" Content="Exit" Tag="&#xE7E8;"
                        Style="{StaticResource NavActionButton}" Click="BtnExit_Click"/>
            </Grid>
        </Border>

        <!-- ============ RIGHT SIDE ============ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="24,0">
                <Grid>
                    <TextBlock x:Name="TxtPageTitle" Text="Order" FontSize="20" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtDate" FontSize="12" Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Page area: the active UserControl is shown here -->
            <ContentControl x:Name="PageHost" Grid.Row="1" Margin="24"
                            IsTabStop="False" Focusable="False"/>
        </Grid>
    </Grid>
</Window>