<UserControl x:Class="OrderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Hearth_Café_Ordering_and_Management_System">

    <UserControl.Resources>
        <local:MoneyConverter x:Key="MoneyFmt"/>

        <!-- One product card -->
        <DataTemplate x:Key="ProductTemplate">
            <Button Style="{StaticResource CardButton}" Margin="6" Click="Product_Click">
                <Border x:Name="Card" Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12">
                    <StackPanel>
                        <Grid Height="80">
                            <Border Background="{StaticResource ChipBrush}" CornerRadius="11,11,0,0">
                                <TextBlock Text="&#x2615;" FontFamily="Segoe UI Symbol" FontSize="26"
                                           Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border CornerRadius="11,11,0,0">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Picture}" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                            <Border x:Name="Badge" Visibility="Collapsed" Width="25" Height="25" CornerRadius="12.5"
                                    Background="{StaticResource PrimaryBrush}"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0">
                                <TextBlock Text="{Binding Qty}" Foreground="White" FontSize="12" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <StackPanel Margin="12">
                            <TextBlock Text="{Binding Product.Name}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Product.Category}" FontSize="10"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
                            <Grid Margin="0,6,0,0">
                                <TextBlock Text="{Binding Product.Price, Converter={StaticResource MoneyFmt}}"
                                           FontSize="14" Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center"/>
                                <Border x:Name="AddBox" Width="28" Height="28" CornerRadius="8"
                                        Background="{StaticResource ChipBrush}" HorizontalAlignment="Right">
                                    <TextBlock x:Name="AddIcon" Text="&#xE710;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="12" Foreground="{StaticResource PrimaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding InCart}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                    <Setter TargetName="Card" Property="BorderThickness" Value="1.5"/>
                    <Setter TargetName="Badge" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="AddBox" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                    <Setter TargetName="AddIcon" Property="Foreground" Value="White"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- One line in the receipt -->
        <DataTemplate x:Key="CartItemTemplate">
            <Grid Margin="0,0,0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding ItemName}" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Text="{Binding LineTotal, Converter={StaticResource MoneyFmt}}"
                           FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>

                <Border Grid.Row="1" Margin="0,4,0,0" HorizontalAlignment="Left"
                        Background="{StaticResource BgBrush}" CornerRadius="6" Padding="4,2">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource IconButton}" Content="&#xE738;" Click="BtnMinus_Click"/>
                        <TextBlock Text="{Binding Quantity}" Width="28" TextAlignment="Center"
                                   VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE710;" Click="BtnPlus_Click"/>
                    </StackPanel>
                </Border>
                <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE74D;"
                        Foreground="{StaticResource MutedBrush}" VerticalAlignment="Bottom"
                        Click="BtnRemove_Click"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- ================= LEFT: products ================= -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Search -->
            <TextBox x:Name="TxtSearch" Grid.Row="0" Style="{StaticResource SearchBox}" Margin="0,0,0,12"
                     Tag="Search products by name…" TextChanged="TxtSearch_TextChanged"/>

            <!-- Category chips -->
            <ItemsControl x:Name="ChipsList" Grid.Row="1" Margin="0,0,0,4">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <RadioButton GroupName="Categories" Style="{StaticResource ChipButton}"
                                     Content="{Binding Label}" Tag="{Binding Key}"
                                     IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                     Checked="Chip_Checked"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Info row -->
            <Grid Grid.Row="2" Margin="0,0,0,12">
                <TextBlock x:Name="TxtCount" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                <TextBlock Text="Tap a product to add it" FontSize="11" HorizontalAlignment="Right"
                           Foreground="{StaticResource MutedBrush}"/>
            </Grid>

            <!-- Product grid -->
            <Grid Grid.Row="3">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ProductList" Margin="-6,-6,-6,0"
                                  ItemTemplate="{StaticResource ProductTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock x:Name="TxtNoProducts" Text="No products found" Visibility="Collapsed"
                           Foreground="{StaticResource MutedBrush}" FontSize="14"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Grid>

        <!-- ================= RIGHT: receipt + payment ================= -->
        <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0">
                    <StackPanel>
                        <TextBlock x:Name="TxtOrderNo" FontSize="18" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock x:Name="TxtOrderDate" FontSize="11" Margin="0,3,0,0"
                                   Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="12"
                            Background="{StaticResource ChipBrush}" Padding="9,4">
                        <TextBlock Text="New" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryBrush}"/>
                    </Border>
                </Grid>

                <!-- Customer name -->
                <StackPanel Grid.Row="1" Margin="0,12,0,0">
                    <TextBox x:Name="TxtCustomer" Style="{StaticResource InputBox}" Height="36"
                             Tag="Customer name (optional)"/>
                    <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,12"/>
                </StackPanel>

                <!-- Cart lines -->
                <Grid Grid.Row="2">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="CartList" ItemTemplate="{StaticResource CartItemTemplate}"/>
                    </ScrollViewer>
                    <TextBlock x:Name="TxtCartEmpty" Text="No items yet" FontSize="12"
                               Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <!-- Notes, totals, payment -->
                <StackPanel Grid.Row="3">
                    <TextBlock Text="Notes:" FontSize="14" Foreground="{StaticResource TextBrush}"
                               Margin="0,8,0,6"/>
                    <TextBox x:Name="TxtNotes" Style="{StaticResource InputBox}" Height="52"
                             Padding="12,8" TextWrapping="Wrap" AcceptsReturn="True"
                             Tag="e.g. Serve coffees together. No sugar."/>

                    <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,12"/>

                    <!-- Subtotal -->
                    <Grid>
                        <TextBlock x:Name="TxtSubtotalLabel" FontSize="13" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock x:Name="TxtSubtotal" FontSize="13" FontWeight="Medium"
                                   Foreground="{StaticResource TextBrush}" HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- Discount -->
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="72"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Discount" FontSize="13" Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="BtnDiscType" Grid.Column="1" Style="{StaticResource SoftButton}"
                                Width="30" Height="30" Content="$" Click="BtnDiscType_Click"/>
                        <TextBox x:Name="TxtDiscount" Grid.Column="2" Style="{StaticResource InputBox}"
                                 Width="64" Height="30" Margin="6,0" FontSize="12" Padding="8,0"
                                 TextAlignment="Right" Tag="0" TextChanged="Totals_Changed"/>
                        <TextBlock x:Name="TxtDiscountAmt" Grid.Column="3" FontSize="13" FontWeight="Medium"
                                   Foreground="{StaticResource TextBrush}" TextAlignment="Right"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Total -->
                    <Grid Margin="0,10,0,0">
                        <TextBlock Text="Total due" FontSize="18" Foreground="{StaticResource TextBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtTotal" FontSize="22" Foreground="{StaticResource TextBrush}"
                                   HorizontalAlignment="Right"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,12"/>

                    <!-- Payment -->
                    <Grid>
                        <TextBlock Text="Payment" FontSize="14" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="Receipt preview" FontSize="10" HorizontalAlignment="Right"
                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,10,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Cash received" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"/>
                            <TextBox x:Name="TxtCash" Style="{StaticResource InputBox}" Margin="0,8,0,0"
                                     Tag="0.00" TextChanged="Totals_Changed"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Change due" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"/>
                            <TextBlock x:Name="TxtChange" FontSize="20" Margin="0,8,0,0"
                                       Foreground="{StaticResource PrimaryBrush}"/>
                        </StackPanel>
                    </Grid>

                    <Button x:Name="BtnConfirm" Style="{StaticResource PrimaryButton}"
                            Click="BtnConfirm_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>