<UserControl x:Class="MenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Hearth_Café_Ordering_and_Management_System">

    <UserControl.Resources>
        <local:MoneyConverter x:Key="MoneyFmt"/>

        <SolidColorBrush x:Key="OkBgBrush"  Color="#EAF0E5"/>
        <SolidColorBrush x:Key="OkFgBrush"  Color="#526B50"/>
        <SolidColorBrush x:Key="OffBgBrush" Color="#F3E3DF"/>
        <SolidColorBrush x:Key="OffFgBrush" Color="#A4493D"/>

        <!-- Table row look: hover + selected -->
        <Style x:Key="RowItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" MinHeight="47" Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ChipBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Category name inside the dropdown (Focusable=False keeps the cursor in the text box) -->
        <Style x:Key="DropItem" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="10,8,34,8">
                            <ContentPresenter HorizontalAlignment="Left"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ChipBrush}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ChipBrush}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One table row -->
        <DataTemplate x:Key="RowTemplate">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="96"/>
                    <ColumnDefinition Width="44"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" Margin="0,6">
                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Description}" FontSize="10" Margin="0,3,0,0"
                               Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Category}" FontSize="11" Margin="0,0,8,0"
                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="2" Text="{Binding Price, Converter={StaticResource MoneyFmt}}"
                           FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                           VerticalAlignment="Center"/>
                <Border Grid.Column="3" x:Name="Pill" HorizontalAlignment="Left" VerticalAlignment="Center"
                        Background="{StaticResource OkBgBrush}" CornerRadius="12" Padding="9,4">
                    <TextBlock x:Name="PillText" Text="Available" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource OkFgBrush}"/>
                </Border>
                <Border Grid.Column="4" x:Name="EditBox" Width="28" Height="28" CornerRadius="6"
                        Background="{StaticResource BgBrush}" HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="EditIcon" Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                               Foreground="{StaticResource PrimaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                    <Setter TargetName="Pill" Property="Background" Value="{StaticResource OffBgBrush}"/>
                    <Setter TargetName="PillText" Property="Text" Value="Unavailable"/>
                    <Setter TargetName="PillText" Property="Foreground" Value="{StaticResource OffFgBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                             Value="True">
                    <Setter TargetName="EditBox" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                    <Setter TargetName="EditIcon" Property="Foreground" Value="White"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- ================= LEFT ================= -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Stats -->
            <Border Grid.Row="0" Background="{StaticResource ChipBrush}" CornerRadius="12" Padding="16"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Menu items" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock x:Name="StatTotal" FontSize="25" Margin="0,6,0,0"
                                   Foreground="{StaticResource TextBrush}"/>
                    </StackPanel>
                    <StackPanel x:Name="StatBox2" Grid.Column="1">
                        <TextBlock x:Name="StatName2" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock x:Name="StatValue2" FontSize="25" Margin="0,6,0,0"
                                   Foreground="{StaticResource TextBrush}"/>
                    </StackPanel>
                    <StackPanel x:Name="StatBox3" Grid.Column="2">
                        <TextBlock x:Name="StatName3" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock x:Name="StatValue3" FontSize="25" Margin="0,6,0,0"
                                   Foreground="{StaticResource TextBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Search -->
            <TextBox x:Name="TxtSearch" Grid.Row="1" Style="{StaticResource SearchBox}" Margin="0,0,0,12"
                     Tag="Search menu items…" TextChanged="TxtSearch_TextChanged"/>

            <!-- Category chips + Add button -->
            <DockPanel Grid.Row="2" Margin="0,0,0,4" LastChildFill="True">
                <Button DockPanel.Dock="Right" VerticalAlignment="Top" Width="150" Height="38"
                        Margin="8,0,0,8" Style="{StaticResource PrimaryButton}" Click="BtnAdd_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Add menu item"/>
                    </StackPanel>
                </Button>
                <ItemsControl x:Name="ChipsList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton GroupName="MenuCategories" Style="{StaticResource ChipButton}"
                                         Content="{Binding Label}" Tag="{Binding Key}"
                                         IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                         Checked="Chip_Checked"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>

            <!-- Table -->
            <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1" CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="32"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource BgBrush}" CornerRadius="11,11,0,0">
                        <Grid Margin="16,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="44"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="PRODUCT" FontSize="10" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="CATEGORY" FontSize="10" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="PRICE" FontSize="10" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="AVAILABILITY" FontSize="10" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <ListBox x:Name="ProductListBox" Grid.Row="1" BorderThickness="0" Background="Transparent"
                             ItemContainerStyle="{StaticResource RowItem}"
                             ItemTemplate="{StaticResource RowTemplate}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="ProductListBox_SelectionChanged"/>

                    <TextBlock x:Name="TxtFooter" Grid.Row="2" FontSize="11" Margin="8,0"
                               Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= RIGHT: add / edit form ================= -->
        <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1" CornerRadius="12" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock x:Name="TxtFormTitle" Text="Add menu item" FontSize="18"
                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE711;" HorizontalAlignment="Right"
                            ToolTip="Close" Click="BtnCancel_Click"/>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,4,0">

                        <!-- Photo -->
                        <Border Height="168" CornerRadius="8" Background="{StaticResource ChipBrush}">
                            <Grid>
                                <TextBlock Text="&#x2615;" FontFamily="Segoe UI Symbol" FontSize="40"
                                           Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Border x:Name="PhotoBox" CornerRadius="8"/>
                            </Grid>
                        </Border>
                        <Grid Margin="0,6,0,12">
                            <TextBlock x:Name="TxtImageInfo" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                            <Button Content="Change photo" Style="{StaticResource LinkButton}"
                                    HorizontalAlignment="Right" Click="BtnChangePhoto_Click"/>
                        </Grid>

                        <!-- Name -->
                        <TextBlock Text="Item name" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBox x:Name="TxtName" Style="{StaticResource InputBox}" Height="36"
                                 Margin="0,4,0,12" Tag="e.g. Cappuccino"/>

                        <!-- Category: type freely, autocompletes, dropdown opens while typing -->
                        <TextBlock Text="Category" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"/>
                        <Grid Margin="0,4,0,0">
                            <TextBox x:Name="TxtCategory" Style="{StaticResource InputBox}" Height="36"
                                     Padding="12,0,36,0" Tag="Type a category or pick one"
                                     TextChanged="TxtCategory_TextChanged"
                                     PreviewKeyDown="TxtCategory_PreviewKeyDown"
                                     LostKeyboardFocus="TxtCategory_LostKeyboardFocus"/>
                            <Button Style="{StaticResource IconButton}" Content="&#xE70D;"
                                    HorizontalAlignment="Right" Margin="0,0,6,0"
                                    ToolTip="Show all categories"
                                    Foreground="{StaticResource MutedBrush}" Click="BtnCategoryDrop_Click"/>

                            <Popup x:Name="CategoryPopup" PlacementTarget="{Binding ElementName=TxtCategory}"
                                   Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                <Border x:Name="PopupCard" Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="4" Margin="0,4,10,10"
                                        MinWidth="200" MaxHeight="220">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.18"/>
                                    </Border.Effect>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="CategoryDropList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Button Style="{StaticResource DropItem}" Content="{Binding Name}"
                                                                Click="CategoryPick_Click"/>
                                                        <Button Content="&#xE74D;" ToolTip="Delete category"
                                                                HorizontalAlignment="Right" Margin="0,0,4,0"
                                                                Focusable="False" Click="CategoryDelete_Click">
                                                            <Button.Style>
                                                                <Style TargetType="Button"
                                                                       BasedOn="{StaticResource IconButton}">
                                                                    <Setter Property="Foreground"
                                                                            Value="{StaticResource MutedBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Name}" Value="Uncategorized">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <!-- Status line: existing / did you mean / new -->
                        <Grid x:Name="CategoryHelp" Margin="0,6,0,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtCategoryHelp" FontSize="11" TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>
                            <Button x:Name="BtnUseSuggestion" Grid.Column="1" Content="Use it"
                                    Style="{StaticResource LinkButton}" Margin="8,0,0,0"
                                    Visibility="Collapsed" Click="BtnUseSuggestion_Click"/>
                        </Grid>

                        <!-- Price -->
                        <TextBlock x:Name="LblPrice" FontSize="12" FontWeight="SemiBold" Margin="0,12,0,0"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBox x:Name="TxtPrice" Style="{StaticResource InputBox}" Height="36"
                                 Margin="0,4,0,12" Tag="0.00"/>

                        <!-- Description -->
                        <TextBlock Text="Description" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBox x:Name="TxtDescription" Style="{StaticResource InputBox}" Height="56"
                                 Margin="0,4,0,12" Padding="12,8" VerticalContentAlignment="Top"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 Tag="Short description (optional)"/>

                        <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,0,0,12"/>

                        <!-- Availability switch -->
                        <Grid Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Available for ordering" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="Visible on the staff order page" FontSize="10" Margin="0,4,0,0"
                                           Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>
                            <ToggleButton x:Name="TglAvailable" Style="{StaticResource SwitchToggle}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="True"/>
                        </Grid>

                        <!-- Buttons -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="95"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="Cancel" Style="{StaticResource OutlineButton}" Click="BtnCancel_Click"/>
                            <Button Grid.Column="2" Content="Save changes" Style="{StaticResource PrimaryButton}"
                                    Click="BtnSave_Click"/>
                        </Grid>

                        <Button x:Name="BtnArchive" Style="{StaticResource DangerButton}" Margin="0,10,0,4"
                                Visibility="Collapsed" Click="BtnArchive_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Archive this item"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>